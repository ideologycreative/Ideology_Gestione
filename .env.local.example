# Copy this file to .env.local and fill in the real values from your
# Supabase project (Project Settings → API).

# Public — safe to ship to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Secret — server-only. NEVER prefix this with NEXT_PUBLIC_, and never
# reference it from client-component code (src/lib/supabase/service.ts
# guards this with `import 'server-only'` so a mistake fails the build
# instead of shipping the key to the browser).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Only used by scripts/seed.mjs, to create the first logins. Optional —
# omit either pair to skip creating that login.
SEED_STUDIO_EMAIL=
SEED_STUDIO_PASSWORD=
SEED_CLIENT_EMAIL=
SEED_CLIENT_PASSWORD=
